# Local development defaults
PORT=8081
SPRING_DATASOURCE_URL=jdbc:h2:file:./data/knowledge-vault;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
H2_CONSOLE_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VAULT_STORAGE_DIR=./uploads
VAULT_JWT_SECRET=local-development-secret-change-before-deploying-1234567890

# For Aiven MySQL, replace the database settings with your own values.
# Never commit real database passwords or production secrets.
# SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/YOUR_DATABASE?sslMode=REQUIRED
# SPRING_DATASOURCE_USERNAME=YOUR_AIVEN_USERNAME
# SPRING_DATASOURCE_PASSWORD=YOUR_AIVEN_PASSWORD
